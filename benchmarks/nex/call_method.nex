-- Method calls on one object (monomorphic): 20M.
import java.lang.System

-- The work's own time, in microseconds, from the JVM's monotonic clock.
function clock_us(): Integer do
  with "java" do
    result := System.nanoTime() / 1000
  end
end

class Counter
  create
    make(b: Integer) do bias := b end
  feature
    bias: Integer
    step(x: Integer): Integer do result := x + bias end
end
function run(n: Integer): Integer do
  let c := create Counter.make(3)
  let total := 0
  from let i := 0 until i = n do
    total := (total + c.step(i)) % 1000003
    i := i + 1
  end
  result := total
end

clock_us() -- warm the clock up before timing
let t0 := clock_us()
let r := run(20000000)
let t1 := clock_us()
print(r)
print(t1 - t0)
