-- Startup: an empty program. Its time is the cost of starting the language.
import java.lang.System

-- The work's own time, in microseconds, from the JVM's monotonic clock.
function clock_us(): Integer do
  let t: Integer := 0
  with "java" do
    t := System.nanoTime()
  end
  result := t / 1000
end

clock_us() -- warm the clock up before timing
let t0 := clock_us()
let r := 0
let t1 := clock_us()
print(r)
print(t1 - t0)
