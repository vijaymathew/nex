-- Closure (fn value) calls: 20M.
import java.lang.System

-- The work's own time, in microseconds, from the JVM's monotonic clock.
function clock_us(): Integer do
  let t: Integer := 0
  with "java" do
    t := System.nanoTime()
  end
  result := t / 1000
end

function run(n: Integer): Integer do
  let f := fn (x: Integer): Integer do result := x + 1 end
  let total := 0
  from let i := 0 until i = n do
    total := (total + f(i)) % 1000003
    i := i + 1
  end
  result := total
end

clock_us() -- warm the clock up before timing
let t0 := clock_us()
let r := run(20000000)
let t1 := clock_us()
print(r)
print(t1 - t0)
