class Stack
  create
    make do
      this.items := []
    end
  feature
    items: Array[Integer]
    pop(): Integer do
      result := items.get(items.length - 1)
    end
end

function drain(s: Stack): Integer do
  result := s.pop + s.pop
end

let s := create Stack.make
print(drain(s))

