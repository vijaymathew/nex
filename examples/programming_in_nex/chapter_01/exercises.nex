-- ============================================================================
-- Programming with Nex — Chapter 1: A Quick Tour of Nex
-- Solutions to the end-of-chapter exercises.
--
-- The exercises ask the reader to change the chapter's programs; the changed
-- logic is gathered here into functions called with test values, so the whole
-- set runs non-interactively:  nex exercises.nex
-- ============================================================================

intern text/Regex

function main() do
  -- --------------------------------------------------------------------------
  -- 1. Two more greetings; keep greeting until each new one has appeared.
  -- --------------------------------------------------------------------------
  let greetings: Array[String] :=
    ["Hello", "Привет", "नमस्ते", "こんにちは", "Γεια σου", "Bonjour", "Hallo"]
  console.print_line("1. greetings.length = " + greetings.length.to_string)   -- 7
  assert greetings.length = 7
  let seen_hallo: Boolean := false
  let seen_bonjour: Boolean := false
  let tries: Integer := 0
  from
  until
    (seen_hallo and seen_bonjour) or tries = 10000
  do
    let g: String := greetings.get(greetings.length.pick)
    if g = "Hallo" then seen_hallo := true end
    if g = "Bonjour" then seen_bonjour := true end
    tries := tries + 1
  end
  assert seen_hallo and seen_bonjour

  -- --------------------------------------------------------------------------
  -- 2. Discussion only. :vars lists greetings and name; after :clear, :vars
  --    lists nothing, and typing `greetings` reports
  --      Error: Undefined variable: greetings
  --    because :clear forgot every definition.
  -- --------------------------------------------------------------------------

  -- --------------------------------------------------------------------------
  -- 3. hello.nex asks for the name when none is given on the command line.
  --    In the program the second argument is console.read_line("What is your
  --    name? "); here it is passed in.
  -- --------------------------------------------------------------------------
  console.print_line("3. " + name_to_greet(["Grace"], "unused"))   -- Grace
  console.print_line("3. " + name_to_greet([], "Ada"))             -- Ada
  assert name_to_greet(["Grace"], "unused") = "Grace"
  assert name_to_greet([], "Ada") = "Ada"

  -- --------------------------------------------------------------------------
  -- 4. Greet every name on the command line (program.arguments in hello.nex).
  --    Compile with  nex compile jvm hello.nex build/  and run
  --    java -jar build/hello.jar Ada Grace Alan
  -- --------------------------------------------------------------------------
  let lines: Array[String] := greet_all(["Ada", "Grace", "Alan"])
  across lines as line do
    console.print_line("4. " + line)
  end
  assert lines.length = 3
  assert lines.get(2).ends_with(", Alan!")

  -- --------------------------------------------------------------------------
  -- 5. The longest word in the file. most_frequent(counts, 0) breaks its
  --    precondition, and the program stops with
  --      Error: Precondition violation: positive_top
  --    naming the call that broke it.
  -- --------------------------------------------------------------------------
  let word_pattern: Regex := create Regex.compile("[a-z']+")
  let words: Array[String] :=
    word_pattern.find_all("Look on my Works, ye Mighty, and despair!".to_lower)
  console.print_line("5. longest word: " + longest(words))   -- despair
  assert longest(words) = "despair"

  -- --------------------------------------------------------------------------
  -- 6.* Discussion with a sketch. In mandelbrot.nex set max_steps to 500 and
  --     change the two lines in `band` that compute x and y to
  --       let x: Real := -0.755 + 0.02 * col.to_real / width.to_real
  --       let y: Real := 0.10 + 0.015 * row.to_real / height.to_real
  --     With band_count 1 every pixel is computed by one task, one after
  --     another; with 8, the bands run on separate cores, so the computing
  --     part is several times faster (start-up time is the same either way).
  -- --------------------------------------------------------------------------
end

-- The name to greet: the first command-line argument, else the typed name.
function name_to_greet(arguments: Array[String], typed: String): String do
  if arguments.is_empty then
    result := typed
  else
    result := arguments.get(0)
  end
end

-- One greeting per name, each in a randomly chosen language.
function greet_all(names: Array[String]): Array[String] do
  let greetings: Array[String] := ["Hello", "Привет", "नमस्ते", "こんにちは", "Γεια σου"]
  result := []
  across names as name do
    result.add(greetings.get(greetings.length.pick) + ", " + name + "!")
  end
end

-- The longest of `words`; the first one wins a tie.
function longest(words: Array[String]): String
  require
    some_words: not words.is_empty
  do
    result := words.get(0)
    across words as word do
      if word.length > result.length then
        result := word
      end
    end
  end

main()
