-- Narrative examples from Chapter 1 (A Quick Tour of Nex), collected into one
-- self-checking, non-interactive program. The REPL transcripts in the chapter
-- are reproduced here as ordinary top-level code with `assert`s standing in
-- for what the reader would see echoed back.
--
-- The chapter's three complete programs are separate files in this folder:
--
--   nex hello.nex Ada                    -- greet a name from the command line
--   nex word_count.nex ozymandias.txt    -- count lines, words, characters
--   nex mandelbrot.nex                   -- draw the Mandelbrot set in parallel
--                                           (writes mandelbrot.png)

-- The REPL in two minutes.
assert 6 * 7 = 42
print("Hello, Nex")
let name: String := "Ada"
assert "Hello, " + name = "Hello, Ada"

-- Hello, in any language. At the REPL the name comes from
-- console.read_line("What is your name? "); here it is the `name` above.
let greetings: Array[String] := ["Hello", "Привет", "नमस्ते", "こんにちは", "Γεια σου"]
assert greetings.length = 5
assert greetings.get(0) = "Hello"
assert greetings.get(3).length = 5     -- characters, not bytes

let position: Integer := greetings.length.pick
assert position >= 0 and position < greetings.length

let greeting: String := greetings.get(greetings.length.pick) + ", " + name + "!"
print(greeting)
assert greetings.any(fn (g) => greeting = g + ", Ada!")
