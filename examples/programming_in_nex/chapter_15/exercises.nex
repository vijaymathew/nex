-- ============================================================================
-- Programming with Nex — Chapter 15: Generic Classes
-- Solutions to the end-of-chapter exercises.   Run:  nex exercises.nex
--
-- Exercises 6 and 7 build on Section 15.8 "Iterating Over Your Own Types":
-- the Cursor protocol (start / item / next / at_end) that makes any class
-- usable with `across`.
-- ============================================================================

-- 7.* The cursor that makes Stack[G] iterable from top to bottom. It is handed
--     the array once, at creation, and walks it backwards; clients never see
--     `items` themselves — the cursor is the only window in.
class Stack_Cursor [G]
  create
    make(data: Array[G]) do items := data  pos := data.length - 1 end
  feature
    items: Array[G]
    pos: Integer
    start() do end
    item(): G do result := items.get(pos) end
    next() do pos := pos - 1 end
    at_end(): Boolean do result := pos < 0 end
end

-- 1. Stack[G] with explicit emptiness preconditions on pop and peek.
--    (7.* adds the `cursor` method at the end of the feature list.)
class Stack [G]
  create
    make() do items := [] end
  feature
    items: Array[G]
    push(value: G) do items.add(value) end
    -- Precondition: the stack must be non-empty.
    pop(): G
      require
        not_empty: items.length > 0
      do
        result := items.get(items.length - 1)
        items.remove(items.length - 1)
      end
    -- Precondition: the stack must be non-empty.
    peek(): G
      require
        not_empty: items.length > 0
      do
        result := items.get(items.length - 1)
      end
    is_empty(): Boolean do result := items.length = 0 end
    size(): Integer do result := items.length end
    -- 7.* One method is all it takes to make Stack[G] usable with `across`.
    cursor(): Stack_Cursor[G]
      do result := create Stack_Cursor[G].make(items) end
end

-- 2. Box[T] and a Logged_Box[T] that counts how often set is called.
class Box [T]
  create
    make(v: T) do value := v end
  feature
    value: T
    get(): T do result := value end
    set(v: T) do value := v end
end

class Logged_Box [T] inherit Box[T]
  create
    make(v: T) do Box.make(v)  change_count := 0 end
  feature
    change_count: Integer
    set(v: T) do
      value := v
      change_count := change_count + 1
    end
    changes(): Integer do result := change_count end
end

-- 3. Range[G -> Comparable].
class Range [G -> Comparable]
  create
    make(l, h: G) do low := l  high := h end
  feature
    low: G
    high: G
    contains(value: G): Boolean do
      result := low <= value and value <= high
    end
    overlaps(other: Range[G]): Boolean do
      result := low <= other.high and other.low <= high
    end
end

-- 5.* Queue[G] and Priority_Queue[G] that keeps elements sorted on insert.
class Queue [G]
  create
    make() do items := [] end
  feature
    items: Array[G]
    enqueue(value: G) do items.add(value) end
    dequeue(): G do
      result := items.get(0)
      items.remove(0)
    end
    front(): G do result := items.get(0) end
    is_empty(): Boolean do result := items.length = 0 end
    size(): Integer do result := items.length end
end

class Priority_Queue [G -> Comparable] inherit Queue[G]
  create
    make() do items := [] end
  feature
    -- Insert so that items stays sorted ascending (smallest at the front),
    -- so dequeue (which removes the front) yields elements in priority order.
    enqueue(value: G) do
      items.add(value)
      items := items.sort
    end
end

-- Section 15.8 "Iterating Over Your Own Types": a user-defined iterable.
-- An Interval generates an inclusive range on demand; it stores no array.
class Interval_Cursor
  create
    make(lo, hi: Integer) do current := lo  last := hi end
  feature
    current: Integer
    last: Integer
    start() do end
    item(): Integer do result := current end
    next() do current := current + 1 end
    at_end(): Boolean do result := current > last end
end

class Interval
  create
    make(lo, hi: Integer) do low := lo  high := hi end
  feature
    low: Integer
    high: Integer
    cursor(): Interval_Cursor
      do result := create Interval_Cursor.make(low, high) end
end

-- 6. Countdown yields n, n-1, ..., 1 when iterated.
class Countdown_Cursor
  create
    make(start_at: Integer) do current := start_at end
  feature
    current: Integer
    start() do end
    item(): Integer do result := current end
    next() do current := current - 1 end
    at_end(): Boolean do result := current < 1 end
end

class Countdown
  create
    make(n: Integer)
      require positive: n > 0
      do top := n end
  feature
    top: Integer
    cursor(): Countdown_Cursor
      do result := create Countdown_Cursor.make(top) end
end

function main() do
  let c: Console := create Console

  -- 1. Happy path; pop on an empty stack would trip `not_empty` (a precondition
  --    violation that halts the program) — the contract turns a silent bad
  --    index into a loud, located failure. We exercise only the valid path here.
  let s: Stack[Integer] := create Stack[Integer].make()
  s.push(10)
  s.push(20)
  c.print_line("1. pop=" + s.pop.to_string + " then peek=" + s.peek.to_string)  -- 20, 10
  c.print_line("1. (pop on an empty stack would violate not_empty and halt.)")

  -- 2.
  let lb: Logged_Box[String] := create Logged_Box[String].make("a")
  lb.set("b")
  lb.set("c")
  c.print_line("2. Logged_Box value=" + lb.get + " changes=" + lb.changes.to_string)  -- c, 2

  -- 3.
  let ri: Range[Integer] := create Range[Integer].make(1, 10)
  c.print_line("3. int range [1,10] contains 5? " + ri.contains(5).to_string +
               " contains 11? " + ri.contains(11).to_string)              -- true false
  let rr: Range[Real] := create Range[Real].make(0.0, 1.0)
  c.print_line("3. real range [0,1] contains 0.5? " + rr.contains(0.5).to_string)  -- true
  let ri2: Range[Integer] := create Range[Integer].make(8, 12)
  c.print_line("3. [1,10] overlaps [8,12]? " + ri.overlaps(ri2).to_string)  -- true

  -- 4. Why ?V in Result[V] (discussion):
  --    The failure constructor builds a Result with NO value — there is nothing
  --    to put in `value`. If the field were plain `V`, it would have to hold a
  --    valid V even on failure, which is impossible for an arbitrary type (there
  --    is no universal default). Making it `?V` (detachable) lets the field be
  --    `nil` in the failure case; the success case attaches a real V. Callers
  --    are then forced to check before use, which is the point.
  c.print_line("4. Result.value is ?V so the failure case can hold nil; a plain" +
               " V would demand a value that failure does not have.")

  -- 5.*
  let pq: Priority_Queue[Integer] := create Priority_Queue[Integer].make()
  across [5, 2, 8, 1, 9] as n do
    pq.enqueue(n)
  end
  c.print("5. dequeue from Priority_Queue (expect ascending): ")
  from
  until
    pq.is_empty
  do
    c.print(pq.dequeue.to_string + " ")
  end
  c.new_line

  -- Section 15.8: a user-defined type used as the source for `across`.
  -- The loop variable arrives as Any (a custom cursor may yield any type), so a
  -- plain print works directly but arithmetic narrows it with `convert`.
  let week: Interval := create Interval.make(1, 7)
  let days: String := ""
  across week as day do
    days := days + day.to_string + " "
  end
  c.print_line("15.8 Interval(1..7)  = " + days.trim)               -- 1 2 3 4 5 6 7

  let total: Integer := 0
  across (create Interval.make(1, 100)) as n do
    if convert n to value: Integer then
      total := total + value
    end
  end
  c.print_line("15.8 sum 1..100      = " + total.to_string)         -- 5050

  -- 6. Countdown, iterated twice to show each `cursor` call is independent.
  let cd: Countdown := create Countdown.make(5)
  let first: String := ""
  across cd as k do first := first + k.to_string + " " end
  let again: String := ""
  across cd as k do again := again + k.to_string + " " end
  c.print_line("6. Countdown(5) twice = " + first.trim + " | " + again.trim)  -- 5 4 3 2 1 | 5 4 3 2 1

  -- 7.* Iterate a Stack[Integer] top-to-bottom and total it via `convert`.
  --     The loop variable is Any because a user-defined cursor is free to yield
  --     any type — the `across` driver only knows the Cursor protocol, not the
  --     element type behind it — so the concrete type is recovered by narrowing.
  let st: Stack[Integer] := create Stack[Integer].make()
  st.push(10)
  st.push(20)
  st.push(30)
  let order: String := ""
  let sum: Integer := 0
  across st as e do
    order := order + e.to_string + " "
    if convert e to v: Integer then
      sum := sum + v
    end
  end
  c.print_line("7. Stack top->bottom  = " + order.trim + " (sum " + sum.to_string + ")")  -- 30 20 10 (sum 60)
end

main()
