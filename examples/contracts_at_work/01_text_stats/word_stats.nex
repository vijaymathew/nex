-- Word_Stats: counts lines, words, and word frequency for a block of text.
-- Pure and host-free — no file or console I/O happens here, so it is fully
-- testable without touching a filesystem or a terminal.

intern text/Regex

class Count_Entry
  create
    make(word: String, count: Integer) do
      this.word := word
      this.count := count
    end
  feature
    word: String
    count: Integer

    to_string(): String do
      result := word + ": " + count
    end
end

class Word_Stats
  create
    make(text: String) do
      this.text := text
    end
  feature
    text: String

    line_count(): Integer
      do
        if text = "" then
          result := 0
        else
          result := text.split("\n").length
        end
      ensure
        non_negative: result >= 0
      end

    words(): Array[String] do
      let rx: Regex := create Regex.compile_with_flags("[a-z']+", "i")
      result := rx.find_all(text)
    end

    word_count(): Integer
      do
        result := words().length
      ensure
        non_negative: result >= 0
      end

    -- The n most frequent words, most frequent first; ties broken
    -- alphabetically so the output is deterministic.
    top_words(n: Integer): Array[Count_Entry]
      require
        positive: n > 0
      do
        let counts: Map[String, Integer] := {}
        let ws: Array[String] := words()
        let i: Integer := 0
        from
          i := 0
        until
          i = ws.length
        do
          let w: String := ws.get(i).to_lower()
          counts.set(w, counts.try_get(w, 0) + 1)
          i := i + 1
        end

        let entries: Array[Count_Entry] := []
        let keys: Array[String] := counts.keys()
        i := 0
        from
          i := 0
        until
          i = keys.length
        do
          let k: String := keys.get(i)
          entries.add(create Count_Entry.make(k, counts.get(k)))
          i := i + 1
        end

        let sorted: Array[Count_Entry] := entries.sort(fn(a: Count_Entry, b: Count_Entry): Integer do
          if a.count /= b.count then
            result := b.count - a.count
          elseif a.word < b.word then
            result := -1
          elseif a.word > b.word then
            result := 1
          else
            result := 0
          end
        end)

        if sorted.length <= n then
          result := sorted
        else
          result := sorted.slice(0, n)
        end
      ensure
        bounded: result.length <= n
      end
end
