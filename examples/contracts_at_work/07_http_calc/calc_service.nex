-- calc_service: an HTTP JSON API embedding Project 4's expression
-- interpreter. POST /evaluate with {"expr": "1 + x", "vars": {"x": 2}}
-- returns {"result": 3.0}, or {"error": "..."} with a 400 status when the
-- expression is malformed or violates one of evaluate's own contracts
-- (division by zero, an undefined variable). The interpreter (expr.nex)
-- doesn't know it's being called over HTTP at all — request parsing and
-- the wire format live entirely in this file.
--
-- Runs on the default JVM backend. Request handling lives on Calc_Service
-- itself as ordinary methods, and the route closure calls `this.handle_
-- evaluate(req)` directly — this used to be impossible (a closure passed
-- as a callback, `fn` or `spawn do...end` alike, couldn't call a method on
-- the enclosing object, forcing everything through free functions and
-- captured locals instead), fixed upstream. See the book's top-level
-- issues report.

intern net/Http_Server
intern data/Json
intern Expr

class Calc_Service
  create
    make(port: Integer) do
      this.server := create Http_Server.make(port)
      this.json := create Json.make()
      server.post("/evaluate", fn(req: Http_Request): Http_Server_Response do
        result := this.handle_evaluate(req)
      end)
    end
  feature
    server: Http_Server
    json: Json

    json_response(status_code: Integer, payload: Map[String, Any]): Http_Server_Response do
      let headers: Map[String, String] := {}
      headers.set("Content-Type", "application/json")
      result := create Http_Server_Response.make(status_code, json.stringify(payload), headers)
    end

    -- The request's variables, as numbers: {"x": 2, "y": 0.5}. `as_real`
    -- accepts a JSON integer too, since evaluate wants Real either way.
    parse_vars(body: Json_Value): Map[String, Real] do
      result := {}
      if body.has("vars") then
        let vars: Json_Value := body.get("vars")
        across vars.keys as name do
          result.set(name, vars.get(name).as_real)
        end
      end
    end

    -- Any problem with the request (not JSON, no "expr", a variable that
    -- isn't a number) or with the expression itself raises, and becomes a
    -- 400 with the error's own message, such as
    -- {"error": "Json: vars.x is a string, expected a number"}.
    handle_evaluate(req: Http_Request): Http_Server_Response do
      do
        let body: Json_Value := json.read(req.body())
        let value: Real := evaluate(body.get("expr").as_string, parse_vars(body))
        let payload: Map[String, Any] := {}
        payload.set("result", value)
        result := json_response(200, payload)
      rescue
        let payload: Map[String, Any] := {}
        payload.set("error", "" + exception)
        result := json_response(400, payload)
      end
    end

    start() do
      server.start()
    end

    stop() do
      server.stop()
    end

    port(): Integer do
      result := server.port
    end
end
