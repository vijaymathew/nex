-- calc_service: an HTTP JSON API embedding Project 4's expression
-- interpreter. POST /evaluate with {"expr": "1 + x", "vars": {"x": 2}}
-- returns {"result": 3.0}, or {"error": "..."} with a 400 status when the
-- expression is malformed or violates one of evaluate's own contracts
-- (division by zero, an undefined variable). The interpreter (expr.nex)
-- doesn't know it's being called over HTTP at all — request parsing and
-- the wire format live entirely in this file.
--
-- Must run under --interpret: this project's request/response bodies are
-- JSON, and data/Json-parsed Map values are unusable on the JVM backend —
-- see Project 2's README and the book's top-level issues report.
--
-- Request handling is free (top-level) functions, not Calc_Service
-- methods, and the route closure captures a local `json` binding rather
-- than reading `this.json`: a closure passed as a callback (an anonymous
-- `fn`, same as `spawn do...end` in Project 6) cannot call a method on the
-- enclosing object, implicitly or via an explicit `this.` prefix — both
-- fail to resolve at typecheck time. Capturing plain local variables in a
-- closure works fine; it's specifically method access on `this` inside one
-- that doesn't. See the book's top-level issues report.

intern net/Http_Server
intern data/Json
intern Expr

function json_response(json: Json, status_code: Integer, payload: Map[String, Any]): Http_Server_Response do
  let headers: Map[String, String] := {}
  headers.set("Content-Type", "application/json")
  result := create Http_Server_Response.make(status_code, json.stringify(payload), headers)
end

-- JSON integers parse as Integer, JSON decimals as Real; evaluate wants
-- Real either way. Integer has no to_real() method (checked against the
-- language reference — Integer's method table has no real-conversion
-- entry); arithmetic promotion (`n + 0.0`) does the conversion instead.
function to_real_any(v: Any): Real do
  if type_is("Integer", v) then
    let n: Integer := v
    result := n + 0.0
  else
    result := v
  end
end

function parse_vars(body: Map[String, Any]): Map[String, Real] do
  result := {}
  if body.contains_key("vars") then
    let raw_vars: Map[String, Any] := body.get("vars")
    let names: Array[String] := raw_vars.keys()
    let i: Integer := 0
    from
      i := 0
    until
      i = names.length
    do
      let name: String := names.get(i)
      result.set(name, to_real_any(raw_vars.get(name)))
      i := i + 1
    end
  end
end

function handle_evaluate(json: Json, req: Http_Request): Http_Server_Response do
  do
    let body: Map[String, Any] := json.parse(req.body())
    let expr_text: String := body.get("expr")
    let vars: Map[String, Real] := parse_vars(body)
    let value: Real := evaluate(expr_text, vars)
    let payload: Map[String, Any] := {}
    payload.set("result", value)
    result := json_response(json, 200, payload)
  rescue
    let payload: Map[String, Any] := {}
    payload.set("error", "" + exception)
    result := json_response(json, 400, payload)
  end
end

class Calc_Service
  create
    make(port: Integer) do
      this.server := create Http_Server.make(port)
      let json: Json := create Json.make()
      server.post("/evaluate", fn(req: Http_Request): Http_Server_Response do
        result := handle_evaluate(json, req)
      end)
    end
  feature
    server: Http_Server

    start() do
      server.start()
    end

    stop() do
      server.stop()
    end

    port(): Integer do
      result := server.port
    end
end
