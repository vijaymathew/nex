-- calc_client: an interactive CLI that sends expressions to calc_service
-- over HTTP and prints the result. Reads the server URL and expressions
-- from stdin, not argv — see Project 1's README for why.
--
-- Builds the request body with data/Json (safe), but reads the response
-- with text/Regex rather than data/Json. Interning both net/Http_Client and
-- data/Json in the same program, then actually calling the client
-- (client.post) and reading a field off a Map that json.parse(...)
-- produced, fails typechecking inside a `function ... do ... end` body with
-- a confusing, unrelated-looking error ("Method 'call0' uses Result but
-- does not declare a return type") — confirmed directly, and only when the
-- client call is real; creating an unused Http_Client alongside a parsed
-- Map does not trigger it. Identical code as bare top-level script
-- statements does not fail either, which is why checks.nex (written as
-- top-level statements) has always been able to call `.get()` on parsed
-- responses without issue. The response shape here is small and entirely
-- under this project's own control (`{"result":N}` or `{"error":"..."}`),
-- so a fixed-lookbehind regex extracts the one field needed without
-- touching data/Json's parse result inside a function at all.

intern net/Http_Client
intern data/Json
intern text/Regex

function main() do
  let console: Console := create Console
  let base: String := console.read_line("server [http://localhost:4322]: ").trim()
  if base = "" then
    base := "http://localhost:4322"
  end

  let client: Http_Client := create Http_Client.make()
  let json: Json := create Json.make()
  let result_rx: Regex := create Regex.compile('(?<="result":)[^,}]+')
  let error_rx: Regex := create Regex.compile('(?<="error":")[^"]+')

  print("type an expression, or 'quit'")
  let running: Boolean := true
  from
    running := true
  until
    not running
  do
    let expr_text: String := console.read_line("> ").trim()
    if expr_text = "quit" then
      running := false
    elseif expr_text /= "" then
      let payload: Map[String, Any] := {}
      payload.set("expr", expr_text)
      let response: Http_Response := client.post(base + "/evaluate", json.stringify(payload))
      let body: String := response.body()
      if response.status() = 200 then
        print("= " + result_rx.find(body))
      else
        print("error: " + error_rx.find(body))
      end
    end
  end
end

main()
