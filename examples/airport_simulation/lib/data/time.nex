declare type Clock_Value = Integer where n: n >= 0 and n < 60

class Clock_Time
feature
  hours: Clock_Value
  minutes: Clock_Value
  seconds: Clock_Value
create
  make(h, m, s: Integer)
  do
    hours := h
    minutes := m
    seconds := s
  end
  from_total_seconds(s: Integer)
  do
    let total_minutes := s / 60
    seconds := s % 60
    hours := total_minutes / 60
    minutes := total_minutes % 60
  end
feature
  total_seconds: Integer
  do
    result := ((hours * 60) + minutes) * 60 + seconds
  end
end

class Time
inherit Comparable
feature
  total_seconds: Integer
create
  make(s: Integer)
  do
    total_seconds := s
  end
feature
  as_clock_time: Clock_Time
  do
    result := create Clock_Time.from_total_seconds(total_seconds)
  end
  compare(other: Time): Integer
  do
    if total_seconds = other.total_seconds then
      result := 0
    elseif total_seconds > other.total_seconds then
      result := 1
    else
      result := -1
    end
  end
  to_string: String
  do
    let ct := as_clock_time
    result := "" + ct.hours + ":" + (when ct.minutes < 10 then "0" else "" end) + ct.minutes
  end  
end

-- A specific time of day from 00:00 (midnight) to below 24:00 (tomorrow)
class Time_Of_Day
inherit Time
create
  from_seconds_passed(s: Integer)
  do
    Time.make(s)
  end
  from_clock_time(t: Clock_Time)
  do
    Time.make(t.total_seconds)
  end
end

class Time_Offset
inherit Time
feature
  past: Boolean
create
  from_seconds(s: Integer)
  do
    past := s < 0
    if past then s := s * -1 end
    Time.make(s)
  end
feature
  plus(other_offset: Time_Offset): Time_Offset
  alias "+"
  do
    let sum := total_seconds + other_offset.total_seconds
    if past then sum := -sum end
    result := create Time_Offset.from_seconds(sum)
  end
  to_string: String
  do
    let sign := when past then "minus" else "plus" end
    result := sign + " " + Time.to_string
  end
end

let tod := create Time_Of_Day.from_seconds_passed(105)
assert tod.total_seconds = 105
let ct0 := create Clock_Time.make(8, 30, 59)
tod := create Time_Of_Day.from_clock_time(ct0)
assert tod.total_seconds = 30659
let ct := tod.as_clock_time
assert decode: ct = ct0

assert tod.to_string = "8:30"

ct0 := create Clock_Time.make(8, 5, 59)
tod := create Time_Of_Day.from_clock_time(ct0)
assert tod.to_string = "8:05"

let offset := create Time_Offset.from_seconds(ct0.total_seconds)
assert not offset.past
assert offset.to_string = "plus 8:05"

offset := create Time_Offset.from_seconds(-create Clock_Time.make(6, 45, 30).total_seconds)
assert offset.past
assert offset.to_string = "minus 6:45"

let offset_2 := offset + create Time_Offset.from_seconds(100)
assert offset_2.to_string = "minus 6:47"

assert offset_2 > offset

print("Time_Of_Day")
