-- database.nex: the facts, kept one relation per predicate.

intern Bindings

-- The facts of one predicate, each once.
class Relation
create
  make(p: String)
  do
    predicate := p
    facts := []
    keys := #{}
  end
feature
  predicate: String
  facts: Array[Atom]
  -- The text of every fact, for asking quickly whether one is here.
  keys: Set[String]

  count: Integer
  do
    result := facts.length
  end

  contains(a: Atom): Boolean
  do
    result := keys.contains(a.text)
  end

  -- Add `a`, unless it is already here. Is it new?
  add(a: Atom): Boolean
  require
    this_predicate: a.predicate = predicate
    ground: a.is_ground
  do
    result := not contains(a)
    if result then
      facts.add(a)
      keys.add(a.text)
    end
  ensure
    present: contains(a)
    counted: count = old count + (when result then 1 else 0 end)
  end

  -- The facts that might match `pattern` once `b` is applied to it.
  -- Here that is simply all of them.
  candidates(pattern: Atom, b: Bindings): Array[Atom]
  do
    result := facts
  ensure
    complete: covers(result, pattern, b)
  end

  -- Is every fact that matches `pattern` under `b` among `found`?
  covers(found: Array[Atom], pattern: Atom, b: Bindings): Boolean
  do
    result := true
    across facts as f do
      if match_atom(pattern, f, b) /= nil and not found.contains(f) then
        result := false
      end
    end
  end
invariant
  one_key_per_fact: keys.size = facts.length
end

-- All the facts known so far.
class Database
create
  make
  do
    relations := {}
  end
feature
  relations: Map[String, Relation]

  -- A relation for a predicate seen for the first time. A kind of
  -- database that stores its facts differently says so here.
  new_relation(p: String): Relation
  do
    result := create Relation.make(p)
  ensure
    for_p: result.predicate = p
    empty: result.count = 0
  end

  has(p: String): Boolean
  do
    result := relations.contains_key(p)
  end

  contains(a: Atom): Boolean
  do
    result := has(a.predicate) and relations.get(a.predicate).contains(a)
  end

  -- Add a fact. Is it new?
  add(a: Atom): Boolean
  require
    ground: a.is_ground
  do
    if not has(a.predicate) then
      relations.put(a.predicate, new_relation(a.predicate))
    end
    result := relations.get(a.predicate).add(a)
  ensure
    present: contains(a)
    only_grows: count >= old count
  end

  -- Add a fact that `rule` derived with the bindings `b`. Is it new?
  add_derived(a: Atom, rule: Rule, b: Bindings): Boolean
  require
    ground: a.is_ground
    from_rule: substitute(rule.head, b).text = a.text
  do
    result := add(a)
  ensure
    present: contains(a)
  end

  facts_of(p: String): Array[Atom]
  do
    result := when has(p) then relations.get(p).facts else [] end
  end

  -- The facts that might match `pattern` under `b`.
  candidates(pattern: Atom, b: Bindings): Array[Atom]
  do
    result := []
    if has(pattern.predicate) then
      result := relations.get(pattern.predicate).candidates(pattern, b)
    end
  end

  count: Integer
  do
    result := 0
    across relations.values as r do
      result := result + r.count
    end
  end

  -- The predicates with facts, in name order.
  predicates: Array[String]
  do
    result := relations.keys.sort
  end
end

-- A relation that also files its facts by their first argument, so that
-- a pattern whose first argument is known looks only at the facts that
-- have it.
class Indexed_Relation inherit Relation
create
  make(p: String)
  do
    Relation.make(p)
    by_first := {}
  end
feature
  by_first: Map[String, Array[Atom]]

  add(a: Atom): Boolean
  do
    result := Relation.add(a)
    if result and a.arity > 0 then
      let key := term_text(a.args.get(0))
      if not by_first.contains_key(key) then
        by_first.put(key, [])
      end
      by_first.get(key).add(a)
    end
  end

  candidates(pattern: Atom, b: Bindings): Array[Atom]
  do
    result := facts
    if pattern.arity > 0 then
      let first := substitute_term(pattern.args.get(0), b)
      if not is_variable(first) then
        result := by_first.try_get(term_text(first), [])
      end
    end
  end
end

-- A database whose relations are indexed.
class Indexed_Database inherit Database
create
  make
  do
    Database.make
  end
feature
  new_relation(p: String): Relation
  do
    result := create Indexed_Relation.make(p)
  end
end
