-- helpers.nex: printing text, numbers, distances and times neatly, and
-- finding the user's files.

-- Print s on a line of its own, without quotes.
function say(s: String) do
  (create Console).print_line(s)
end

-- r with exactly `places` digits after the decimal point: fixed(2.5, 3)
-- is "2.500".
function fixed(r: Real, places: Integer): String
require
  non_negative: places >= 0
do
  let scale: Integer := 10 ^ places
  let scaled: Integer := (r.abs * scale.to_real).round
  let whole: String := (scaled / scale).to_string
  let frac: String := (scaled % scale).to_string.pad_start("0", places)
  result := when r < 0.0 and scaled > 0 then "-" else "" end + whole
  if places > 0 then
    result := result + "." + frac
  end
end

-- A distance the way a navigator says it: "40 m", "350 m", "1.2 km".
-- Under a kilometre it is rounded to 10 m, which is as precise as a
-- driver needs.
function distance_text(metres: Real): String
require
  non_negative: metres >= 0.0
do
  if metres < 995.0 then
    result := ((metres / 10.0).round * 10).to_string + " m"
  else
    result := fixed(metres / 1000.0, 1) + " km"
  end
end

-- A duration in whole minutes, "under a minute" or "1 h 05 min".
function duration_text(seconds: Real): String
require
  non_negative: seconds >= 0.0
do
  let minutes: Integer := (seconds / 60.0).round
  if minutes < 1 then
    result := "under a minute"
  elseif minutes < 60 then
    result := minutes.to_string + " min"
  else
    result := (minutes / 60).to_string + " h "
      + (minutes % 60).to_string.pad_start("0", 2) + " min"
  end
end

-- The full path of a file the user named. The `nex` launcher runs
-- programs from its own installation folder, so a relative name is
-- resolved against the folder `nex` was started from, NEX_USER_DIR.
function user_path(raw: String): String do
  let user_dir: String := (create Process).getenv("NEX_USER_DIR")
  if raw.starts_with("/") or user_dir = "" then
    result := raw
  else
    result := user_dir + "/" + raw
  end
end
