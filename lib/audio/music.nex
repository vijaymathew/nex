-- Music: a recorded track — background music, an ambience loop — with
-- play, pause, resume, stop and looping.
--
--   let theme := create Music.load("theme.wav")
--   theme.set_looping(true)
--   theme.play()
--   ...
--   theme.pause()                 -- the pause menu
--   theme.resume()
--
-- The state machine and its contracts come from Track; see track.nex for
-- why the state follows the program's calls and why a game calls update()
-- once per frame to notice a track that has played to its end.
--
-- Files are WAV, AIFF or AU with uncompressed (PCM) audio, resolved against
-- NEX_USER_DIR like Sound.load. The whole file is held in memory, which
-- suits tracks of a few minutes.
--
-- No sound device. Without one (or with NEX_AUDIO=off) a Music still loads,
-- knows its length and moves through its states as usual, but plays nothing:
-- its position stays at 0 and it never reaches its end by itself.
--
-- Import with `intern audio/Music`.

intern audio/Track
intern audio/Audio_Device

import java.io.File
import javax.sound.sampled.AudioSystem
import javax.sound.sampled.Clip

class Music
  note "Recorded background music with play, pause, resume, stop and looping."
  inherit Track

create
  -- The WAV, AIFF or AU file FILENAME (relative to NEX_USER_DIR).
  load(filename: String)
    require
      has_name: filename.length > 0
    do
      support := create Audio_Support.make()
      let path: String := support.resolve(filename)
      if not support.is_file(path) then
        raise "Music.load: no such file: " + path
      end
      let frames: Integer := 0
      let rate: Real := 1.0
      do
        with "java" do
          let info: Any := AudioSystem.getAudioFileFormat(File.new(path))
          frames := info.getFrameLength()
          rate := info.getFormat().getFrameRate()
        end
      rescue
        raise "Music.load: not a readable WAV, AIFF or AU file: " + path
      end
      source := filename
      duration_ms := (frames.to_real * 1000.0 / rate).round
      if duration_ms < 1 then duration_ms := 1 end
      clip := nil
      if (create Audio_Device.make()).is_available() then
        do
          with "java" do
            let opened: Any := AudioSystem.getClip()
            opened.open(AudioSystem.getAudioInputStream(File.new(path)))
            clip := opened
          end
        rescue
          clip := nil
        end
      end
      set_volume(1.0)
    ensure
      named: source = filename
      stopped: is_stopped()
    end

feature
  source: String
  duration_ms: Integer

  -- Whether the track will actually be heard (a device is present).
  is_audible(): Boolean do
    result := clip /= nil
  end

  -- How far into the track playback is, in milliseconds.
  position_ms(): Integer do
    result := 0
    if ?clip as c then
      let us: Integer := 0
      with "java" do
        us := c.getMicrosecondPosition()
      end
      result := us / 1000
      if result > duration_ms then result := duration_ms end
    end
  end

  -- Move to MS without changing whether the track is playing.
  seek(ms: Integer)
    require
      open: not is_closed
      in_track: ms >= 0 and ms <= duration_ms
    do
      if ?clip as c then
        with "java" do
          c.setMicrosecondPosition(ms * 1000)
        end
      end
    ensure
      same_state: playing = old playing and paused = old paused
    end

  reached_end(): Boolean do
    result := false
    if ?clip as c then
      if not is_looping then
        let running: Boolean := false
        let at: Integer := 0
        let length: Integer := 0
        with "java" do
          running := c.isRunning()
          at := c.getMicrosecondPosition()
          length := c.getMicrosecondLength()
        end
        result := not running and at >= length
      end
    end
  end

  start_from_beginning() do
    if ?clip as c then
      with "java" do
        c.setMicrosecondPosition(0)
      end
      run(c)
    end
  end

  halt() do
    if ?clip as c then
      with "java" do
        c.stop()
      end
    end
  end

  carry_on() do
    if ?clip as c then
      run(c)
    end
  end

  rewind() do
    if ?clip as c then
      with "java" do
        c.stop()
        c.setMicrosecondPosition(0)
      end
    end
  end

  looping_changed() do
    if ?clip as c then
      if is_playing() then
        with "java" do
          c.stop()
        end
        run(c)
      end
    end
  end

  volume_changed() do
    if ?clip as c then
      support.apply_volume(c, volume)
    end
  end

  release() do
    if ?clip as c then
      with "java" do
        c.close()
      end
    end
    clip := nil
  end

private feature
  -- The javax.sound.sampled.Clip holding the track; nil without a device.
  clip: ?Any
  support: Audio_Support

  -- Start C from where it is, once or looping.
  run(c: Any) do
    if is_looping then
      with "java" do
        c.loop(Clip.LOOP_CONTINUOUSLY)
      end
    else
      with "java" do
        c.start()
      end
    end
  end

invariant
  positive_length: duration_ms > 0
  position_in_track: position_ms() >= 0 and position_ms() <= duration_ms
end
