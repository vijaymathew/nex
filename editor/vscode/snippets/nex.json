{
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "  create",
      "    make(${2:value: Integer}) do",
      "      $3",
      "    end",
      "",
      "  feature",
      "    $0",
      "",
      "  invariant",
      "    ${4:valid}: ${5:true}",
      "end"
    ],
    "description": "Class with a constructor, features and an invariant"
  },
  "Routine with contracts": {
    "prefix": "routine",
    "body": [
      "${1:name}(${2:n: Integer}): ${3:Integer}",
      "  require",
      "    ${4:label}: ${5:n >= 0}",
      "  do",
      "    $0",
      "  ensure",
      "    ${6:label}: ${7:result >= 0}",
      "  end"
    ],
    "description": "Routine with require / ensure"
  },
  "Function": {
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:n: Integer}): ${3:Integer} do",
      "  $0",
      "end"
    ],
    "description": "Top-level function"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "  $0",
      "end"
    ]
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} then",
      "  $2",
      "else",
      "  $0",
      "end"
    ]
  },
  "From loop": {
    "prefix": "from",
    "body": [
      "from",
      "  let ${1:i} := ${2:0}",
      "invariant",
      "  ${3:bounded}: ${1:i} <= ${4:n}",
      "variant",
      "  ${4:n} - ${1:i}",
      "until",
      "  ${1:i} = ${4:n}",
      "do",
      "  $0",
      "  ${1:i} := ${1:i} + 1",
      "end"
    ],
    "description": "Loop with invariant and variant"
  },
  "Across": {
    "prefix": "across",
    "body": [
      "across ${1:items} as ${2:item} do",
      "  $0",
      "end"
    ]
  },
  "Repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} do",
      "  $0",
      "end"
    ]
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} of",
      "  ${2:Variant} as ${3:v} then $0",
      "end"
    ]
  },
  "Union": {
    "prefix": "union",
    "body": [
      "union ${1:Name}",
      "  ${2:First}",
      "  ${3:Second}(${4:value: Integer})",
      "end"
    ]
  },
  "Let": {
    "prefix": "let",
    "body": "let ${1:name}: ${2:Integer} := ${0:0}"
  }
}
