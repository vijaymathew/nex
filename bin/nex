#!/bin/bash
# Nex Language Command-Line Interface (JVM)

VERSION="0.5.8"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_NEX_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -n "${NEX_HOME:-}" ]]; then
    NEX_HOME="$NEX_HOME"
elif [[ -f "$REPO_NEX_HOME/deps.edn" && -d "$REPO_NEX_HOME/src" ]]; then
    NEX_HOME="$REPO_NEX_HOME"
else
    NEX_HOME="/usr/local/lib/nex"
fi

# install.sh may put a Clojure CLI next to this script (for example under
# ~/.local/bin); prefer it over any older one elsewhere on PATH.
PATH="$SCRIPT_DIR:$PATH"

# Helper functions
show_help() {
    cat <<'EOF'
Nex Language v0.5.8 - A high-level language for design and implementation

USAGE:
    nex [NEX_SCRIPT | COMMAND] [OPTIONS]

COMMANDS:
    (no command)              Start the Nex REPL
    compile jvm <file> [output-dir] [--classpath entries] [--skip-contracts]
                              Compile a Nex file to a standalone JVM JAR
    format <file|dir>         Format Nex source files
    doc <file|dir> [output]   Generate documentation from Nex files
    eval <code>               Evaluate a Nex code snippet
    help                      Show this help message

OPTIONS:
    --classpath entries       Extra jar/dir paths for Java interop, colon-
                              separated (same convention as `java -cp` on
                              this platform). Available on both running
                              (nex <file>.nex) and compiling
                              (nex compile jvm). On compile, the entries are
                              also shaded into the output jar.
    --skip-contracts          Lower require/ensure/invariant checks to no-ops
                              (both class and loop invariants). Bare `assert`
                              always runs regardless — there is no mode that
                              strips it. Meant for a trusted, perf-critical
                              release build; risky wherever untrusted input
                              or latent bugs remain. Available on both
                              running (nex <file>.nex) and compiling
                              (nex compile jvm).

EXAMPLES:
    nex                                      # Start REPL
    nex app.nex                              # Run app.nex (compiled JVM backend)
    nex app.nex --interpret                  # Run on the tree-walking interpreter
    nex app.nex --classpath a.jar:b.jar      # Run with extra jars on the classpath
    nex app.nex --skip-contracts             # Run with require/ensure/invariant checks off
    nex compile jvm app.nex                  # Compile to a standalone app.jar in current dir
    nex compile jvm app.nex build/           # Compile to a standalone app.jar in build/
    nex compile jvm app.nex --classpath a.jar:b.jar
                                              # Compile, bundling extra jars into the output jar
    nex compile jvm app.nex --skip-contracts
                                              # Compile a release build with contracts off
    nex format src/                          # Format all files in directory
    nex format MyClass.nex                   # Format single file
    nex doc MyClass.nex MyClass.md           # Generate documentation
    nex doc src/ docs/                       # Generate docs for directory
    nex eval 'print("Hello, World!")'        # Evaluate code

ENVIRONMENT VARIABLES:
    NEX_HOME                  Nex installation directory (default: auto-detected)

For more information, visit: https://github.com/your-repo/nex
EOF
}

show_version() {
    echo "Nex Language v$VERSION (JVM)"
}

J_OPTIONS="${J_OPTIONS:--J--enable-native-access=ALL-UNNAMED}"
USER_DIR="$(pwd)"

# JVM system properties (-Dk=v) for the next run_main call.
NEX_JVM_PROPS=()

# An installed Nex (install.sh) ships an AOT-compiled nex.jar plus its
# dependency jars, listed in $NEX_HOME/classpath, and runs them with plain
# `java`. A source checkout has neither and loads the Clojure source through
# the Clojure CLI instead, which is several times slower to start.
NEX_CP=""
if [[ -f "$NEX_HOME/nex.jar" && -f "$NEX_HOME/classpath" ]]; then
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -n "$entry" ]] && NEX_CP="${NEX_CP:+$NEX_CP:}$NEX_HOME/$entry"
    done < "$NEX_HOME/classpath"
fi

# Version of the `java` on PATH (e.g. 21.0.12), read from the JDK's `release`
# file when there is one, which is much cheaper than starting a JVM.
java_version() {
    local java_bin home
    java_bin="$(command -v java)" || return 0
    home="$(dirname "$(dirname "$(readlink -f "$java_bin")")")"
    if [[ -f "$home/release" ]]; then
        sed -n 's/^JAVA_VERSION="\(.*\)"/\1/p' "$home/release"
    else
        java -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1
    fi
}

# Per-user JVM class-data cache, which roughly halves startup again: an AOT
# cache on Java 25+, an AppCDS archive on Java 17-24. Built once per Nex and
# JDK version by a background run of aot-training.nex after the first
# program finishes, so no run ever waits for it or prints anything about it.
# A cache that no longer matches is ignored by the JVM (its messages about
# that are silenced) and rebuilt when nex.jar is newer than it.
# NEX_JVM_CACHE=off disables it.
NEX_CACHE_OPTS=()
NEX_CACHE_TRAIN=()
NEX_CACHE_FILE=""
setup_jvm_cache() {
    [[ -n "$NEX_CP" && "${NEX_JVM_CACHE:-on}" != off ]] || return 0
    local version major dir
    version="$(java_version)"
    major="${version%%[.+_-]*}"
    [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 17 )) || return 0
    dir="${XDG_CACHE_HOME:-$HOME/.cache}/nex"
    mkdir -p "$dir" 2> /dev/null || return 0

    NEX_CACHE_OPTS=(-Xlog:cds=off -Xlog:class+path=off)
    if (( major >= 25 )); then
        NEX_CACHE_FILE="$dir/nex-$VERSION-java-$version.aot"
        NEX_CACHE_OPTS+=(-Xlog:aot=off)
    else
        NEX_CACHE_FILE="$dir/nex-$VERSION-java-$version.jsa"
    fi

    if [[ -f "$NEX_CACHE_FILE" && "$NEX_CACHE_FILE" -nt "$NEX_HOME/nex.jar" ]]; then
        if (( major >= 25 )); then
            NEX_CACHE_OPTS+=(-XX:AOTCache="$NEX_CACHE_FILE")
        else
            NEX_CACHE_OPTS+=(-XX:SharedArchiveFile="$NEX_CACHE_FILE")
        fi
    elif [[ -f "$NEX_HOME/aot-training.nex" ]]; then
        local tmp="$dir/.tmp-$$-${NEX_CACHE_FILE##*/}"
        if (( major >= 25 )); then
            NEX_CACHE_TRAIN=(-XX:AOTCacheOutput="$tmp")
        else
            NEX_CACHE_TRAIN=(-XX:ArchiveClassesAtExit="$tmp")
        fi
    fi
}

# Build the class-data cache in the background (see setup_jvm_cache). A lock
# directory keeps concurrent runs from training at the same time; one left
# behind by a killed run is cleared after ten minutes.
train_jvm_cache() {
    local -a java_opts=("$@")
    local dir="${NEX_CACHE_FILE%/*}"
    local lock="$dir/.training"
    local tmp="${NEX_CACHE_TRAIN[0]#*=}"
    find "$lock" -maxdepth 0 -mmin +10 -exec rm -rf {} + 2> /dev/null
    mkdir "$lock" 2> /dev/null || return 0
    (
        trap '' HUP
        cd "$NEX_HOME" \
            && java -XX:+UseSerialGC "${NEX_CACHE_OPTS[@]}" "${NEX_CACHE_TRAIN[@]}" "${java_opts[@]}" \
                    -cp "$NEX_CP" clojure.main -m nex.eval "$NEX_HOME/aot-training.nex" \
            && [[ -s "$tmp" ]] \
            && mv -f "$tmp" "$NEX_CACHE_FILE"
        rm -rf "$tmp" "$lock"
    ) < /dev/null > /dev/null 2>&1 &
}

# Run `clojure.main -m NS ARGS...` from NEX_HOME:
#   run_main EXTRA_CP NS [ARGS...]
# EXTRA_CP (colon-separated, `java -cp` style, may be empty) is appended to
# Nex's own classpath, and is put on the real JVM classpath from process start
# so both compile-time interop resolution (Class/forName) and runtime class
# linkage see it — no dynamic classloader trickery, and no reliance on
# `URLClassLoader`, which the JDK 9+ app classloader isn't.
run_main() {
    local extra_cp="$1"
    shift
    local -a java_opts=()
    local tok
    for tok in $J_OPTIONS; do
        java_opts+=("${tok#-J}")
    done
    java_opts+=("${NEX_JVM_PROPS[@]}")

    if [[ -n "$NEX_CP" ]]; then
        # The class-data cache is tied to the exact classpath, so runs with
        # extra entries go without it rather than rebuilding it every time.
        [[ -z "$extra_cp" ]] && setup_jvm_cache
        local status=0
        (cd "$NEX_HOME" && java -XX:+UseSerialGC "${NEX_CACHE_OPTS[@]}" "${java_opts[@]}" \
            -cp "$NEX_CP${extra_cp:+:$extra_cp}" clojure.main -m "$@") || status=$?
        if (( ${#NEX_CACHE_TRAIN[@]} > 0 )); then
            train_jvm_cache "${java_opts[@]}"
        fi
        return $status
    elif [[ -n "$extra_cp" ]]; then
        local base_cp
        base_cp="$(cd "$NEX_HOME" && clojure -Spath)" || exit 1
        cd "$NEX_HOME" && java "${java_opts[@]}" -cp "${base_cp}:${extra_cp}" clojure.main -m "$@"
    else
        local -a clj_opts=()
        for tok in "${java_opts[@]}"; do
            clj_opts+=("-J$tok")
        done
        cd "$NEX_HOME" && clojure "${clj_opts[@]}" -M -m "$@"
    fi
}

# Command implementations
cmd_repl() {
    NEX_JVM_PROPS=(-Dnex.user.dir="$USER_DIR")
    run_main "" nex.repl
}

cmd_compile() {
    # `intern`'s path-qualified lookup (`units/Money`) falls back to
    # NEX_USER_DIR for the project root — needed once a narrowing site is
    # reached transitively (script -> lib A -> lib B, B in a different lib/
    # subdirectory than A), where the immediately-interning file's own
    # directory isn't the right root (see nex.interpreter/intern-search-
    # roots). cmd_run_script exports this; cmd_compile didn't, so `nex
    # compile jvm` failed on exactly the programs `nex <file>` already ran.
    export NEX_USER_DIR="$USER_DIR"

    local classpath=""
    local skip_contracts=""
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --classpath)
                if [[ -z "$2" ]]; then
                    echo "Error: --classpath requires an argument"
                    exit 1
                fi
                classpath="$2"
                shift 2
                ;;
            --skip-contracts)
                skip_contracts="1"
                shift
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done
    set -- "${positional[@]}"

    local target="$1"
    local file="$2"
    local output="$3"

    if [[ -z "$target" || -z "$file" ]]; then
        echo "Error: compile requires target and file arguments"
        echo "Usage: nex compile jvm <file> [output-dir] [--classpath entries] [--skip-contracts]"
        exit 1
    fi

    if [[ "$target" != "jvm" ]]; then
        echo "Error: Invalid target '$target'. The only compile target is 'jvm'."
        exit 1
    fi

    if [[ ! -f "$file" ]]; then
        echo "Error: File not found: $file"
        exit 1
    fi

    # Use absolute path for file
    file="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"

    # The JVM target defaults to the user's current directory
    if [[ -z "$output" ]]; then
        output="$USER_DIR"
    fi

    # Make output path absolute
    mkdir -p "$output"
    output="$(cd "$output" && pwd)"

    local -a extra_flags=()
    if [[ -n "$skip_contracts" ]]; then
        extra_flags+=(--skip-contracts)
    fi

    run_main "$classpath" nex.compiler.jvm.file "$file" "$output" "${extra_flags[@]}"
}

cmd_format() {
    local path="$1"

    if [[ -z "$path" ]]; then
        echo "Error: format requires a file or directory argument"
        echo "Usage: nex format <file|dir>"
        exit 1
    fi

    if [[ ! -e "$path" ]]; then
        echo "Error: Path not found: $path"
        exit 1
    fi

    # Use absolute path
    path="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"

    if [[ -d "$path" ]]; then
        # Format all .nex files in directory
        find "$path" -name "*.nex" -type f | while read -r file; do
            echo "Formatting: $file"
            run_main "" nex.fmt "$file"
        done
    else
        run_main "" nex.fmt "$path"
    fi
}

cmd_doc() {
    local input="$1"
    local output="$2"

    if [[ -z "$input" ]]; then
        echo "Error: doc requires an input file or directory"
        echo "Usage: nex doc <file|dir> [output]"
        exit 1
    fi

    if [[ ! -e "$input" ]]; then
        echo "Error: Path not found: $input"
        exit 1
    fi

    # Use absolute path
    input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"

    if [[ -d "$input" ]]; then
        # Generate docs for all .nex files in directory
        local output_dir="${output:-.}"
        mkdir -p "$output_dir"
        output_dir="$(cd "$output_dir" && pwd)"

        find "$input" -name "*.nex" -type f | while read -r file; do
            local basename="$(basename "$file" .nex)"
            local output_file="$output_dir/${basename}.md"
            echo "Generating docs: $file -> $output_file"
            run_main "" nex.docgen "$file" "$output_file"
        done
    else
        if [[ -z "$output" ]]; then
            # Output to stdout
            run_main "" nex.docgen "$input"
        else
            # Output to file
            run_main "" nex.docgen "$input" "$output"
        fi
    fi
}

cmd_eval() {
    local code="$1"

    if [[ -z "$code" ]]; then
        echo "Error: eval requires a code argument"
        echo "Usage: nex eval '<code>'"
        exit 1
    fi

    # Create temporary file with the code
    local tmpfile=$(mktemp /tmp/nex.XXXXXX.nex)
    echo "$code" > "$tmpfile"

    # Parse and evaluate
    run_main "" nex.eval "$tmpfile"

    # Clean up
    rm -f "$tmpfile"
}

cmd_run_script() {
    export NEX_USER_DIR=`pwd`
    fullpath=$(readlink -f "$1")
    shift

    local classpath=""
    local -a rest=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --classpath)
                if [[ -z "$2" ]]; then
                    echo "Error: --classpath requires an argument"
                    exit 1
                fi
                classpath="$2"
                shift 2
                ;;
            *)
                rest+=("$1")
                shift
                ;;
        esac
    done

    run_main "$classpath" nex.eval "$fullpath" "${rest[@]}"
}

# Main command dispatcher
main() {
    local command="${1:-repl}"

    case "$command" in
        repl)
            cmd_repl
            ;;
        compile)
            shift
            cmd_compile "$@"
            ;;
        format)
            shift
            cmd_format "$@"
            ;;
        doc)
            shift
            cmd_doc "$@"
            ;;
        eval)
            shift
            cmd_eval "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
	    if [[ -f "$command" && "$command" == *.nex ]]; then
		cmd_run_script "$@"
		exit $?
	    else
		echo "Error: Unknown command '$command'"
		echo "Run 'nex help' for usage information."
		exit 1
	    fi
            ;;
    esac
}

main "$@"
