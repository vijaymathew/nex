#!/bin/bash
# Nex command-line launcher for Linux and macOS (bin/nex.cmd is the Windows
# one). It finds Nex and Java, puts Nex's jars and any `--classpath` entries
# on the JVM classpath, and starts nex.cli, which handles the command line
# itself (see src/nex/cli.clj).
#
# Nex runs from one of:
#   - a prebuilt release (scripts/package-release.sh): this script's parent
#     folder holds nex.jar, its dependency jars in deps/, and a `classpath`
#     file listing them. Only Java 17 or later is needed.
#   - a source checkout (deps.edn and src/): the Clojure source is loaded
#     through the Clojure CLI, which is several times slower to start.
# NEX_HOME, when set, names the folder to use instead.

VERSION="0.6.4"
MIN_JAVA=17

# This script's real folder, following symlinks such as one from
# ~/.local/bin/nex (macOS before 12.3 has no `readlink -f`).
script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
SCRIPT_DIR="$(script_dir)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -z "${NEX_HOME:-}" ]]; then
    NEX_HOME="$BASE_DIR"
fi
if [[ ! -f "$NEX_HOME/nex.jar" && ! -f "$NEX_HOME/deps.edn" ]]; then
    echo "Error: no Nex installation found in $NEX_HOME" >&2
    echo "(expected nex.jar from a Nex release, or deps.edn from a source checkout)." >&2
    exit 1
fi

# Older installers put a Clojure CLI next to this script (for example under
# ~/.local/bin); prefer it over any older one elsewhere on PATH.
PATH="$SCRIPT_DIR:$PATH"

# JAVA_HOME's Java when it has one, else `java` on PATH.
JAVA="java"
if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    JAVA="$JAVA_HOME/bin/java"
fi

J_OPTIONS="${J_OPTIONS:--J--enable-native-access=ALL-UNNAMED}"

# Relative paths on the command line are resolved by nex.cli against this
# folder, since the JVM runs in NEX_HOME; programs see it as their working
# directory.
export NEX_USER_DIR="$(pwd)"

# A release lists its jars, relative to NEX_HOME, in $NEX_HOME/classpath.
NEX_CP=""
if [[ -f "$NEX_HOME/nex.jar" && -f "$NEX_HOME/classpath" ]]; then
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -n "$entry" ]] && NEX_CP="${NEX_CP:+$NEX_CP:}$NEX_HOME/$entry"
    done < "$NEX_HOME/classpath"
fi

# The real path of FILE, following symlinks.
real_path() {
    local src="$1" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    echo "$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
}

# Version of $JAVA (e.g. 21.0.12), read from the JDK's `release` file when
# there is one, which is much cheaper than starting a JVM.
java_version() {
    local java_bin home
    java_bin="$(command -v "$JAVA")" || return 0
    home="$(dirname "$(dirname "$(real_path "$java_bin")")")"
    if [[ -f "$home/release" ]]; then
        sed -n 's/^JAVA_VERSION="\(.*\)"/\1/p' "$home/release"
    else
        "$JAVA" -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1
    fi
}

# Major number of a Java version: 21 for 21.0.12, 8 for 1.8.0_402.
java_major() {
    local v="$1"
    [[ "$v" == 1.* ]] && v="${v#1.}"
    echo "${v%%[.+_-]*}"
}

# Stop with a clear message when there is no Java, or it is too old to run
# Nex (the compiler emits Java 17 class files).
check_java() {
    if ! command -v "$JAVA" &> /dev/null; then
        echo "Error: Nex needs Java $MIN_JAVA or later, and no Java was found." >&2
        echo "Install one from https://adoptium.net/ (or set JAVA_HOME)." >&2
        exit 1
    fi
    JAVA_VERSION="$(java_version)"
    JAVA_MAJOR="$(java_major "$JAVA_VERSION")"
    if [[ "$JAVA_MAJOR" =~ ^[0-9]+$ ]] && (( JAVA_MAJOR < MIN_JAVA )); then
        echo "Error: Nex needs Java $MIN_JAVA or later, but $JAVA is Java $JAVA_VERSION." >&2
        echo "Install a newer one from https://adoptium.net/ (or set JAVA_HOME)." >&2
        exit 1
    fi
}

# Per-user JVM class-data cache, which roughly halves startup again: an AOT
# cache on Java 25+, an AppCDS archive on Java 17-24. Built once per Nex and
# JDK version by a background run of aot-training.nex after the first
# program finishes, so no run ever waits for it or prints anything about it.
# A cache that no longer matches is ignored by the JVM (its messages about
# that are silenced) and rebuilt when nex.jar is newer than it.
# NEX_JVM_CACHE=off disables it.
NEX_CACHE_OPTS=()
NEX_CACHE_TRAIN=()
NEX_CACHE_FILE=""
setup_jvm_cache() {
    [[ "${NEX_JVM_CACHE:-on}" != off ]] || return 0
    local version="$JAVA_VERSION" major="$JAVA_MAJOR" dir
    [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 17 )) || return 0
    dir="${XDG_CACHE_HOME:-$HOME/.cache}/nex"
    mkdir -p "$dir" 2> /dev/null || return 0

    NEX_CACHE_OPTS=(-Xlog:cds=off -Xlog:class+path=off)
    if (( major >= 25 )); then
        NEX_CACHE_FILE="$dir/nex-$VERSION-java-$version.aot"
        NEX_CACHE_OPTS+=(-Xlog:aot=off)
    else
        NEX_CACHE_FILE="$dir/nex-$VERSION-java-$version.jsa"
    fi

    if [[ -f "$NEX_CACHE_FILE" && "$NEX_CACHE_FILE" -nt "$NEX_HOME/nex.jar" ]]; then
        if (( major >= 25 )); then
            NEX_CACHE_OPTS+=(-XX:AOTCache="$NEX_CACHE_FILE")
        else
            NEX_CACHE_OPTS+=(-XX:SharedArchiveFile="$NEX_CACHE_FILE")
        fi
    elif [[ -f "$NEX_HOME/aot-training.nex" ]]; then
        local tmp="$dir/.tmp-$$-${NEX_CACHE_FILE##*/}"
        if (( major >= 25 )); then
            NEX_CACHE_TRAIN=(-XX:AOTCacheOutput="$tmp")
        else
            NEX_CACHE_TRAIN=(-XX:ArchiveClassesAtExit="$tmp")
        fi
    fi
}

# Build the class-data cache in the background (see setup_jvm_cache). A lock
# directory keeps concurrent runs from training at the same time; one left
# behind by a killed run is cleared after ten minutes.
train_jvm_cache() {
    local -a java_opts=("$@")
    local dir="${NEX_CACHE_FILE%/*}"
    local lock="$dir/.training"
    local tmp="${NEX_CACHE_TRAIN[0]#*=}"
    find "$lock" -maxdepth 0 -mmin +10 -exec rm -rf {} + 2> /dev/null
    mkdir "$lock" 2> /dev/null || return 0
    (
        trap '' HUP
        cd "$NEX_HOME" \
            && "$JAVA" -XX:+UseSerialGC "${NEX_CACHE_OPTS[@]}" "${NEX_CACHE_TRAIN[@]}" "${java_opts[@]}" \
                    -cp "$NEX_CP" clojure.main -m nex.cli "$NEX_HOME/aot-training.nex" \
            && [[ -s "$tmp" ]] \
            && mv -f "$tmp" "$NEX_CACHE_FILE"
        rm -rf "$tmp" "$lock"
    ) < /dev/null > /dev/null 2>&1 &
}

# The value of the last `--classpath ENTRIES` among the arguments, if any,
# with each relative entry made absolute: the JVM runs in NEX_HOME, but the
# entries are relative to the folder nex was started from. It goes on the
# real JVM classpath from process start, so both compile-time interop
# resolution (Class/forName) and runtime class linkage see it — no dynamic
# classloader trickery. nex.cli drops the option itself.
extra_classpath() {
    local cp="" entry out=""
    local -a entries=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == --classpath && $# -ge 2 ]]; then
            cp="$2"
            shift
        fi
        shift
    done
    # read -a rather than an unquoted expansion, which would glob `dir/*`.
    IFS=: read -r -a entries <<< "$cp"
    for entry in "${entries[@]}"; do
        [[ -z "$entry" ]] && continue
        [[ "$entry" != /* ]] && entry="$NEX_USER_DIR/$entry"
        out="${out:+$out:}$entry"
    done
    echo "$out"
}

main() {
    local extra_cp tok
    extra_cp="$(extra_classpath "$@")"

    local -a java_opts=()
    for tok in $J_OPTIONS; do
        java_opts+=("${tok#-J}")
    done
    java_opts+=(-Dnex.user.dir="$NEX_USER_DIR" -Dnex.home="$NEX_HOME")

    if [[ -n "$NEX_CP" ]]; then
        check_java
        # The class-data cache is tied to the exact classpath, so runs with
        # extra entries go without it rather than rebuilding it every time.
        [[ -z "$extra_cp" ]] && setup_jvm_cache
        local status=0
        (cd "$NEX_HOME" && "$JAVA" -XX:+UseSerialGC "${NEX_CACHE_OPTS[@]}" "${java_opts[@]}" \
            -cp "$NEX_CP${extra_cp:+:$extra_cp}" clojure.main -m nex.cli "$@") || status=$?
        if (( ${#NEX_CACHE_TRAIN[@]} > 0 )); then
            train_jvm_cache "${java_opts[@]}"
        fi
        return $status
    elif [[ -n "$extra_cp" ]]; then
        local base_cp
        base_cp="$(cd "$NEX_HOME" && clojure -Spath)" || exit 1
        cd "$NEX_HOME" && "$JAVA" "${java_opts[@]}" -cp "${base_cp}:${extra_cp}" clojure.main -m nex.cli "$@"
    else
        local -a clj_opts=()
        for tok in "${java_opts[@]}"; do
            clj_opts+=("-J$tok")
        done
        cd "$NEX_HOME" && clojure "${clj_opts[@]}" -M -m nex.cli "$@"
    fi
}

main "$@"
